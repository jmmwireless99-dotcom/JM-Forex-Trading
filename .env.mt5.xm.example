# XM MT5 Demo — JM FX connection template
# Copy to .env on the machine that can read MT5 Common\Files
# DO NOT commit real passwords or tokens

JM_EXECUTION_MODE=mt5
JM_MT5_BRIDGE_DIR=C:\Users\YOUR_USER\AppData\Roaming\MetaQuotes\Terminal\Common\Files
JM_MT_SYMBOL=GOLD
JM_MT5_DEMO_ACCOUNT_CODE=

JM_DEFAULT_STRATEGY=AI_ML
JM_AUTO_STRATEGY=true
JM_DEFAULT_SYMBOLS=XAUUSD
JM_AI_ASSIST=true
JM_AI_GATE_ENTRIES=true
JM_AI_MIN_WIN_PROB=0.40

# Optional: pin auto fills when back on paper mode
# JM_AUTO_FILL_SINGLE_BOOK=true
# JM_AUTO_FILL_ACCOUNT_CODE=
