[Unit]
Description=JM Lab Trading API (paper demo, port 8001)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/jm-forex-trading/lab-backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/jm-forex-trading/lab-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
