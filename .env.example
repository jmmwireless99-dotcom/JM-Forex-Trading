# Copy to .env locally — DO NOT commit real passwords or paths with secrets

JM_EXECUTION_MODE=paper
JM_DEFAULT_STRATEGY=manual_only
JM_AUTO_STRATEGY=false
JM_DEFAULT_SYMBOLS=XAUUSD
JM_INITIAL_BALANCE=1000
JM_MAX_RISK_PER_TRADE_PCT=0.5
JM_MAX_OPEN_POSITIONS=1
JM_SESSION_FILTER=true
JM_NEWS_FILTER=true

# Postgres (optional — desk works without it)
# JM_DATABASE_URL=postgresql+psycopg://jm:jm_scalp_2026@127.0.0.1:5432/jm_forex
# JM_DATABASE_AUTO_MIGRATE=true
# JM_DATABASE_SEED_ON_BOOT=true

# AI / ML trade assist (history + win-prob coach; can gate weak entries)
JM_AI_ASSIST=true
JM_AI_GATE_ENTRIES=true
JM_AI_MIN_WIN_PROB=0.40
JM_AI_SKIP_CONFIDENCE=0.55
# JM_AI_HISTORY_PATH=data/ai_trade_history.jsonl
# JM_AI_MODEL_PATH=data/ai_trade_model.json

# After MT4 EA is running on your PC:
# JM_EXECUTION_MODE=mt4
# JM_MT4_BRIDGE_DIR=C:\Users\YOUR_USER\AppData\Roaming\MetaQuotes\Terminal\Common\Files
# JM_MT4_SYMBOL=XAUUSD
